    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst message = $('RECIEVES STUDENTS JAMB MESSAGE').item.json.message.text;\n\nconst allowedSubjects = [\n  \"Mathematics\",\n  \"Biology\",\n  \"Chemistry\",\n  \"Physics\",\n  \"Literature in English\",\n  \"Economics\"\n];\n\nconst selected = message\n  .split(\",\")\n  .map(subject => subject.trim());\n\nconst normalized = selected.map(subject => subject.toLowerCase());\n\nconst uniqueSubjects = [...new Set(normalized)];\n\nconst valid =\n  selected.length === 3 &&\n  uniqueSubjects.length === 3 &&\n  selected.every(subject =>\n    allowedSubjects.some(\n      allowed => allowed.toLowerCase() === subject.toLowerCase()\n    )\n  );\n\nconst correctedSubjects = selected.map(subject =>\n  allowedSubjects.find(\n    allowed => allowed.toLowerCase() === subject.toLowerCase()\n  )\n);\n\nreturn {\n  json: {\n    ...$json,\n    elective_valid: valid,\n    elective_subjects: valid ? correctedSubjects.join(\", \") : \"\",\n    validation_message: valid\n      ? \"Your elective subjects are valid.\"\n      : \"Invalid selection. Please choose exactly THREE different subjects from the approved list.\"\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -560,
        -608
      ],
